<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="CAPTAIN DESIGNS — Pakistan's marketplace for premium graphic design: logos, thumbnails, banners and more.">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '' %>CAPTAIN DESIGNS — Graphics Marketplace</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpath d='M32 3 L55 12 V30 C55 46 45 56 32 61 C19 56 9 46 9 30 V12 Z' fill='%230e2a52' stroke='%23c9a227' stroke-width='4'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Georgia,serif' font-size='30' font-weight='bold' fill='white'%3EC%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <svg class="brand-emblem" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 3 L55 12 V30 C55 46 45 56 32 61 C19 56 9 46 9 30 V12 Z" fill="#0e2a52" stroke="#c9a227" stroke-width="3.5"/>
        <path d="M32 8.5 L50 15.5 V30 C50 42.5 42 51 32 55.5 C22 51 14 42.5 14 30 V15.5 Z" fill="none" stroke="#c9a227" stroke-width="1" opacity="0.55"/>
        <text x="32" y="40" text-anchor="middle" font-family="Georgia,'Times New Roman',serif" font-size="27" font-weight="bold" fill="#ffffff">C</text>
        <g stroke="#c9a227" stroke-width="2" fill="none" stroke-linecap="round">
          <circle cx="32" cy="45.5" r="1.8"/>
          <line x1="32" y1="47.5" x2="32" y2="54"/>
          <line x1="27.5" y1="49.5" x2="36.5" y2="49.5"/>
          <path d="M25.5 51.5 C25.5 55 28.5 56 32 56 C35.5 56 38.5 55 38.5 51.5"/>
        </g>
      </svg>
      <span class="brand-word">CAPTAIN <em>DESIGNS</em></span>
    </a>
    <nav class="main-nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <a href="/browse" class="<%= path.startsWith('/browse') || path.startsWith('/gig/') ? 'active' : '' %>">Browse Gigs</a>
      <% if (user) { %>
        <% if (user.role !== 'buyer' || user.is_admin) { %>
          <a href="/seller" class="<%= path.startsWith('/seller') ? 'active' : '' %>">Seller Dashboard</a>
        <% } %>
        <% if (user.role !== 'seller' || user.is_admin) { %>
          <a href="/buyer/orders" class="<%= path.startsWith('/buyer') ? 'active' : '' %>">My Orders</a>
        <% } %>
        <a href="/inbox" class="<%= path.startsWith('/inbox') ? 'active' : '' %>">Inbox<% if (unread) { %> <span class="badge"><%= unread %></span><% } %></a>
        <% if (user.is_admin) { %>
          <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a>
        <% } %>
        <span class="nav-user">⚓ <%= user.name.split(' ')[0] %></span>
        <a href="/settings" class="<%= path === '/settings' ? 'active' : '' %>">Settings</a>
        <a href="/logout" class="btn btn-sm btn-outline-light">Logout</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/signup" class="btn btn-sm btn-gold">Join Free</a>
      <% } %>
    </nav>
    <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.main-nav').classList.toggle('open')">☰</button>
  </div>
</header>
<% if (flash) { %>
  <div class="container"><div class="flash flash-<%= flash.type %>"><%= flash.msg %></div></div>
<% } %>
<main class="container page">
