<%- include('partials/head') %>

<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">⚓ Pakistan's Design Marketplace</div>
    <h1>Set sail with <span class="gold">stunning designs</span></h1>
    <p class="hero-sub">Hire talented designers for logos, YouTube thumbnails, Facebook covers, banners and more — or open your own seller cabin and start earning.</p>
    <form class="hero-search" action="/browse" method="GET">
      <input type="text" name="q" placeholder="Try &quot;logo&quot;, &quot;thumbnail&quot;, &quot;banner&quot;…" aria-label="Search gigs">
      <button type="submit" class="btn btn-gold">Search</button>
    </form>
    <div class="hero-stats">
      <div><strong><%= stats.gigs %></strong><span>Active gigs</span></div>
      <div><strong><%= stats.sellers %></strong><span>Designers</span></div>
      <div><strong><%= stats.done %></strong><span>Orders completed</span></div>
    </div>
  </div>
  <div class="hero-rope"></div>
</section>

<section class="section">
  <h2 class="section-title">Browse by category</h2>
  <div class="chip-row">
    <% const catCount = {}; counts.forEach(c => catCount[c.category] = c.c); %>
    <% categories.forEach(cat => { %>
      <a class="chip" href="/browse?category=<%= encodeURIComponent(cat) %>">
        <span class="chip-name"><%= cat %></span>
        <span class="chip-n"><%= catCount[cat] || 0 %> gigs</span>
      </a>
    <% }) %>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Featured gigs</h2>
    <a href="/browse" class="link-more">View all →</a>
  </div>
  <div class="grid gigs-grid">
    <% featured.forEach(g => { %><%- include('partials/gig_card', { g }) %><% }) %>
  </div>
  <% if (!featured.length) { %><p class="muted">No gigs yet — be the first seller to publish one!</p><% } %>
</section>

<section class="section how">
  <h2 class="section-title">How it works</h2>
  <div class="grid how-grid">
    <div class="how-card"><div class="how-n">1</div><h3>Find your designer</h3><p>Browse gigs or message any seller directly through the built-in inbox.</p></div>
    <div class="how-card"><div class="how-n">2</div><h3>Place your order</h3><p>Order in one click. Pay the seller directly via JazzCash, Easypaisa or bank transfer.</p></div>
    <div class="how-card"><div class="how-n">3</div><h3>Receive &amp; approve</h3><p>Get your finished design, request revisions if needed, then confirm completion.</p></div>
  </div>
  <div class="cta-row">
    <a href="/signup" class="btn btn-gold btn-lg">Start selling today</a>
    <a href="/browse" class="btn btn-navy btn-lg">Hire a designer</a>
  </div>
</section>

<%- include('partials/foot') %>
